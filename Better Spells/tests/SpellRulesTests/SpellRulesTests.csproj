<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <KilnHost Condition="'$(KilnHost)' == ''">D:\SteamLibrary\steamapps\common\Enshrouded\kiln\host</KilnHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Kiln mod's rules, catalog and settings, without the game: the mod class itself needs a running Kiln. -->
    <Compile Include="..\..\src\better-spells-kiln\SpellRules.cs" Link="SpellRules.cs" />
    <Compile Include="..\..\src\better-spells-kiln\SpellCatalog.cs" Link="SpellCatalog.cs" />
    <Compile Include="..\..\src\better-spells-kiln\SpellSettings.cs" Link="SpellSettings.cs" />
    <!-- Only for the settings' attributes (key, range, comment), which the tests read. -->
    <Reference Include="Kiln.Api" HintPath="$(KilnHost)\Kiln.Api.dll" />
  </ItemGroup>

</Project>
